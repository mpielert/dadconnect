# DadConnect — environment variables
# Copy this file to .env.local and fill in the real values from your Supabase
# project (Supabase dashboard → Project Settings → API).
#
# .env.local is gitignored and must NEVER be committed (Handoff §7).
# The same three values must also be set in Vercel → Project → Settings →
# Environment Variables for the production deployment.

# Project URL (looks like https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Public anon / publishable key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SECRET. Server-side only, full DB access, bypasses RLS.
# Never expose to the browser and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret protecting /api/cron/message-digest. The pg_cron job sends it
# as `Authorization: Bearer <value>`. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# Resend API key (sending access) used to send the unread-message digest.
# Separate from the SMTP password Supabase uses for auth emails, though the
# same key value works for both.
RESEND_API_KEY=
